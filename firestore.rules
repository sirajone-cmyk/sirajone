rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function userProfileExists(userId) {
      return exists(userPath(userId));
    }

    function userProfileData(userId) {
      return get(userPath(userId)).data;
    }

    function myProfileExists() {
      return signedIn() && userProfileExists(request.auth.uid);
    }

    function myProfileData() {
      return userProfileData(request.auth.uid);
    }

    function isKnownRole(role) {
      return role in ['Student', 'Teacher', 'Admin', 'Co-Admin', 'Counsellor', 'Counselor', 'counsellingClient', 'CounsellingClient'];
    }

    function isKnownStatus(status) {
      return status in ['approved', 'pending', 'suspended'];
    }

    function isOwnerEmail() {
      return signedIn()
        && request.auth.token.email in [
          'sirajone7@gmail.com',
          'madrassatahseenulquraan@gmail.com'
        ];
    }

    function isApprovedUser() {
      return myProfileExists()
        && myProfileData().status == 'approved'
        && isKnownRole(myProfileData().role);
    }

    function isAdminUser() {
      return myProfileExists()
        && myProfileData().status == 'approved'
        && myProfileData().role in ['Admin', 'Co-Admin'];
    }

    function roleAndStatusUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;
    }

    function validStudentSignup() {
      return request.resource.data.role == 'Student'
        && request.resource.data.status == 'approved';
    }

    function validTeacherApplication() {
      return request.resource.data.role == 'Teacher'
        && request.resource.data.status == 'pending';
    }

    function validCounsellorApplication() {
      return request.resource.data.role in ['Counsellor', 'Counselor']
        && request.resource.data.status == 'pending';
    }

    function validCounsellingClientSignup() {
      return request.resource.data.role == 'counsellingClient'
        && request.resource.data.status == 'pending';
    }

    function validOwnerBootstrap() {
      return isOwnerEmail()
        && request.resource.data.role == 'Admin'
        && request.resource.data.status == 'approved';
    }

    function validSelfProfileCreate(userId) {
      return isSelf(userId)
        && !userProfileExists(userId)
        && isKnownRole(request.resource.data.role)
        && isKnownStatus(request.resource.data.status)
        && (validStudentSignup() || validTeacherApplication() || validCounsellorApplication() || validCounsellingClientSignup() || validOwnerBootstrap());
    }

    function onlyTeacherEditablePublicFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['bio', 'personalityDescription', 'assignedSubjects', 'updated_at']);
    }

    function validTeacherPublicProfileCreate(userId) {
      return isSelf(userId)
        && request.resource.data.profileStatus == 'pending';
    }

    function onlyCounsellorEditablePublicFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['bio', 'displayName', 'profilePhoto', 'languagesSpoken', 'serviceDeliveryModes', 'availability', 'updated_at']);
    }

    function validCounsellorPublicProfileCreate(userId) {
      return isSelf(userId)
        && request.resource.data.profileStatus == 'pending';
    }

    function ownsCounsellingRequestData(data) {
      return signedIn()
        && (
          data.studentId == request.auth.uid
          || data.clientId == request.auth.uid
          || data.counsellorId == request.auth.uid
        );
    }

    function validCounsellingRequestCreate() {
      return isApprovedUser()
        && (request.resource.data.studentId == request.auth.uid || request.resource.data.clientId == request.auth.uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.counsellorId is string
        && request.resource.data.categories is list;
    }

    function ownsCounsellingClientData(data) {
      return signedIn() && (
        data.clientId == request.auth.uid
        || data.studentId == request.auth.uid
        || data.counsellorId == request.auth.uid
      );
    }

    function validCounsellingSessionCreate() {
      return isApprovedUser()
        && request.resource.data.counsellorId is string
        && (request.resource.data.clientId is string || request.resource.data.studentId is string)
        && ownsCounsellingClientData(request.resource.data);
    }

    function validCounsellingMessageCreate() {
      return isApprovedUser()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.body is string
        && request.resource.data.counsellorId is string
        && (request.resource.data.clientId is string || request.resource.data.studentId is string)
        && ownsCounsellingClientData(request.resource.data);
    }

    function validCounsellingResourceCreate() {
      return isApprovedUser()
        && request.resource.data.counsellorId is string
        && (request.resource.data.clientId is string || request.resource.data.studentId is string)
        && ownsCounsellingClientData(request.resource.data);
    }

    function onlySeatIncrementChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats_taken', 'updated_at'])
        && request.resource.data.seats_taken == resource.data.seats_taken + 1;
    }

    function validPendingPaymentEnrollment() {
      return isApprovedUser()
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.payment_status == 'pending_payment'
        && request.resource.data.program_id is string;
    }

    function ownsEnrollmentData(data) {
      return signedIn() && data.student_id == request.auth.uid;
    }

    function ownsPaymentData(data) {
      return signedIn()
        && (
          data.student_id == request.auth.uid
          || data.custom_str1 == request.auth.uid
        );
    }

    function isSubmissionStage(stage) {
      return stage in ['letter_guide', 'practical_workbook', 'part_two', 'murshidul_qari', 'hifz'];
    }

    function isSubmissionStatus(status) {
      return status in ['pending', 'approved', 'needs_improvement'];
    }

    function ownsSubmission(data) {
      return signedIn() && data.studentId == request.auth.uid;
    }

    function teachesSubmission(data) {
      return isApprovedUser()
        && myProfileData().role == 'Teacher'
        && data.teacherId == request.auth.uid;
    }

    function validSubmissionCreate() {
      return isApprovedUser()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.teacherId is string
        && isSubmissionStage(request.resource.data.stage)
        && request.resource.data.lessonId is string
        && request.resource.data.itemId is string
        && request.resource.data.studentAudioUrl is string
        && request.resource.data.status == 'pending'
        && request.resource.data.teacherFeedbackAudioUrl == null;
    }

    function validTeacherSubmissionReview() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'teacherFeedbackAudioUrl', 'teacherFeedbackAudioPath', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'updatedAt'])
        && isSubmissionStatus(request.resource.data.status)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.stage == resource.data.stage
        && request.resource.data.lessonId == resource.data.lessonId
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.studentAudioUrl == resource.data.studentAudioUrl;
    }

    function validAssignmentCreate() {
      return isApprovedUser()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.type in ['teacher', 'counsellor']
        && request.resource.data.status in ['pending_admin', 'pending_educator']
        && request.resource.data.keys().hasOnly([
          'studentId',
          'studentName',
          'studentEmail',
          'assignedId',
          'assignedName',
          'type',
          'status',
          'note',
          'categories',
          'preferredContact',
          'createdAt',
          'updatedAt'
        ]);
    }

    function ownsAssignmentData(data) {
      return signedIn()
        && (data.studentId == request.auth.uid || data.assignedId == request.auth.uid);
    }

    function validEducatorAssignmentDecision() {
      return isApprovedUser()
        && resource.data.assignedId == request.auth.uid
        && resource.data.status == 'pending_educator'
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.type == resource.data.type
        && request.resource.data.assignedId == resource.data.assignedId
        && request.resource.data.assignedName == resource.data.assignedName
        && request.resource.data.status in ['active', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'acceptedAt', 'declinedAt']);
    }
    function hasParticipantIds(data) {
      return data.keys().hasAll(['participantIds'])
        && data.participantIds is list;
    }

    function isConversationParticipant(data) {
      return signedIn()
        && hasParticipantIds(data)
        && request.auth.uid in data.participantIds;
    }

    function isBroadcastForMyRole(data) {
      return isApprovedUser()
        && data.keys().hasAll(['type', 'audience'])
        && data.type == 'broadcast'
        && (
          (data.audience == 'Teachers' && myProfileData().role == 'Teacher')
          || (data.audience == 'Students' && myProfileData().role == 'Student')
          || (data.audience == 'Clients' && myProfileData().role == 'counsellingClient')
        );
    }

    // ─── Counselling ecosystem helpers ────────────────────────────────────────

    function isCounsellorUser() {
      return myProfileExists()
        && myProfileData().status == 'approved'
        && myProfileData().role in ['Counsellor', 'Counselor'];
    }

    function isCounsellingClientUser() {
      return myProfileExists()
        && myProfileData().status == 'approved'
        && myProfileData().role == 'counsellingClient';
    }

    function validProgrammeRegistration() {
      return isApprovedUser()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.registrationType in ['enrolled', 'waitlist', 'interest']
        && request.resource.data.status == 'pending';
    }

    function ownsProgrammeRegistration(data) {
      return signedIn() && data.clientId == request.auth.uid;
    }

    function validEventReservation() {
      return isApprovedUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'reserved';
    }

    function ownsEventReservation(data) {
      return signedIn() && data.userId == request.auth.uid;
    }

    function validSessionNoteCreate() {
      return isCounsellorUser()
        && request.resource.data.counsellorId == request.auth.uid
        && request.resource.data.clientId is string
        && request.resource.data.sessionId is string;
    }

    function ownsSessionNote(data) {
      return isCounsellorUser() && data.counsellorId == request.auth.uid;
    }

    function validClientAssessmentCreate() {
      return isCounsellorUser()
        && request.resource.data.counsellorId == request.auth.uid
        && request.resource.data.clientId is string;
    }

    function ownsClientAssessment(data) {
      return isCounsellorUser() && data.counsellorId == request.auth.uid;
    }

    function canReadConversationData(data) {
      return isAdminUser()
        || (isApprovedUser() && (isConversationParticipant(data) || isBroadcastForMyRole(data)));
    }

    function canCreateConversationData(data) {
      return isAdminUser()
        || (
          isApprovedUser()
          && data.keys().hasAll(['type', 'participantIds'])
          && data.type in ['support', 'direct', 'teacher']
          && isConversationParticipant(data)
        );
    }

    function canUpdateConversationData(data) {
      return isAdminUser()
        || (isApprovedUser() && isConversationParticipant(data));
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdminUser();
      allow create: if validSelfProfileCreate(userId) || isAdminUser();
      allow update: if isSelf(userId) && roleAndStatusUnchanged();
      allow update: if isAdminUser();
      allow delete: if isAdminUser();
    }

    match /library/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdminUser();
    }
    match /onboarding_feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId',
          'role',
          'email',
          'displayName',
          'stepId',
          'feedback',
          'createdAt'
        ]);
      allow read, update, delete: if isAdminUser();
    }


    match /programs/{documentId} {
      allow read: if true;
      allow create, delete: if isAdminUser();
      allow update: if isAdminUser()
        || (isApprovedUser() && onlySeatIncrementChanged());
    }

    match /teachers/{userId} {
      allow read: if isAdminUser() || isSelf(userId) || (isApprovedUser() && resource.data.profileStatus == 'approved');
      allow create: if validTeacherPublicProfileCreate(userId) || isAdminUser();
      allow update: if isAdminUser()
        || (isSelf(userId) && onlyTeacherEditablePublicFieldsChanged());
      allow delete: if isAdminUser();

      match /private_data/verification {
        allow read: if isAdminUser() || isSelf(userId);
        allow create: if isSelf(userId);
        allow update, delete: if isAdminUser();
      }

      match /private_data/{documentId} {
        allow read, write: if false;
      }
    }

    match /counsellors/{userId} {
      allow read: if isAdminUser() || isSelf(userId) || (isApprovedUser() && resource.data.profileStatus == 'approved');
      allow create: if validCounsellorPublicProfileCreate(userId) || isAdminUser();
      allow update: if isAdminUser()
        || (isSelf(userId) && onlyCounsellorEditablePublicFieldsChanged());
      allow delete: if isAdminUser();

      match /private_data/verification {
        allow read: if isAdminUser() || isSelf(userId);
        allow create: if isSelf(userId);
        allow update, delete: if isAdminUser();
      }

      match /private_data/{documentId} {
        allow read, write: if false;
      }
    }

    match /counsellingRequests/{documentId} {
      allow read: if isAdminUser() || ownsCounsellingRequestData(resource.data);
      allow create: if validCounsellingRequestCreate();
      allow update: if isAdminUser()
        || (ownsCounsellingRequestData(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'lastMessageAt', 'studentNote', 'clientNote', 'counsellorReply', 'counsellorNote', 'followUpPending', 'followUpStatus', 'lastSessionAt', 'clientName', 'clientEmail']));
      allow delete: if isAdminUser();
    }

    match /assignments/{documentId} {
      allow read: if isAdminUser() || ownsAssignmentData(resource.data);
      allow create: if validAssignmentCreate() || isAdminUser();
      allow update: if isAdminUser() || validEducatorAssignmentDecision();
      allow delete: if isAdminUser();
    }
    match /enrollments/{documentId} {
      allow read: if isAdminUser() || ownsEnrollmentData(resource.data);
      allow create: if validPendingPaymentEnrollment();
      allow update, delete: if isAdminUser();
    }

    match /payments/{documentId} {
      allow read: if isAdminUser() || ownsPaymentData(resource.data);
      allow create, update, delete: if false;
    }

    match /submissions/{documentId} {
      allow read: if isAdminUser() || ownsSubmission(resource.data) || teachesSubmission(resource.data);
      allow create: if validSubmissionCreate();
      allow update: if (isAdminUser() || teachesSubmission(resource.data))
        && validTeacherSubmissionReview();
      allow delete: if isAdminUser()
        || (ownsSubmission(resource.data) && resource.data.status == 'needs_improvement');
    }

    match /payouts/{documentId} {
      allow read, create, update, delete: if isAdminUser();
    }

    match /conversations/{conversationId} {
      allow read: if canReadConversationData(resource.data);
      allow create: if canCreateConversationData(request.resource.data);
      allow update: if canUpdateConversationData(resource.data);
      allow delete: if isAdminUser();

      match /messages/{messageId} {
        allow read: if canReadConversationData(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if canReadConversationData(get(/databases/$(database)/documents/conversations/$(conversationId)).data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.body is string;
        allow update: if false;
        allow delete: if isAdminUser()
          || (signedIn() && resource.data.senderId == request.auth.uid);
      }
    }

    match /messages/{documentId} {
      allow read, create, update, delete: if false;
    }

    match /classrooms/{subjectId}/announcements/{documentId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Co-Admin', 'Teacher'];
    }

    match /classrooms/{subjectId}/media/{documentId} {
      allow read: if signedIn();
      allow write: if signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Co-Admin', 'Teacher'];
    }

    match /counsellingSessions/{documentId} {
      allow read: if isAdminUser() || ownsCounsellingClientData(resource.data);
      allow create: if isAdminUser() || validCounsellingSessionCreate();
      allow update, delete: if isAdminUser() || (isApprovedUser() && resource.data.counsellorId == request.auth.uid);
    }

    match /counsellingMessages/{documentId} {
      allow read: if isAdminUser() || ownsCounsellingClientData(resource.data);
      allow create: if isAdminUser() || validCounsellingMessageCreate();
      allow update, delete: if isAdminUser() || (signedIn() && resource.data.senderId == request.auth.uid);
    }

    match /counsellingResources/{documentId} {
      allow read: if isAdminUser() || ownsCounsellingClientData(resource.data);
      allow create: if isAdminUser() || validCounsellingResourceCreate();
      allow update, delete: if isAdminUser() || (isApprovedUser() && resource.data.counsellorId == request.auth.uid);
    }

    match /contacts/{documentId} {
      allow create: if signedIn();
      allow read, update, delete: if isAdminUser();
    }

    match /settings/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdminUser();
    }

    // ─── Counselling Programmes ───────────────────────────────────────────────
    match /counselling_programmes/{programmeId} {
      allow read: if isApprovedUser();
      allow create, update, delete: if isAdminUser();
    }

    // ─── Programme Registrations ─────────────────────────────────────────────
    match /programme_registrations/{registrationId} {
      allow read: if isAdminUser()
        || isCounsellorUser()
        || ownsProgrammeRegistration(resource.data);
      allow create: if validProgrammeRegistration() || isAdminUser();
      allow update: if isAdminUser()
        || (ownsProgrammeRegistration(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'cancelled');
      allow delete: if isAdminUser();
    }

    // ─── Community Events ────────────────────────────────────────────────────
    // Public read — community events are open to everyone
    match /community_events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdminUser();
    }

    // ─── Event Reservations ──────────────────────────────────────────────────
    match /event_reservations/{reservationId} {
      allow read: if isAdminUser() || ownsEventReservation(resource.data);
      allow create: if validEventReservation() || isAdminUser();
      allow update: if isAdminUser()
        || (ownsEventReservation(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'cancelled');
      allow delete: if isAdminUser();
    }

    // ─── Client Assessments ──────────────────────────────────────────────────
    // Clients NEVER read their own assessment notes — counsellor shares verbally
    match /client_assessments/{assessmentId} {
      allow read: if isAdminUser() || ownsClientAssessment(resource.data);
      allow create: if validClientAssessmentCreate() || isAdminUser();
      allow update: if isAdminUser() || ownsClientAssessment(resource.data);
      allow delete: if isAdminUser();
    }

    // ─── Session Notes ───────────────────────────────────────────────────────
    // Private counsellor notes — clients cannot read under any circumstance
    match /session_notes/{noteId} {
      allow read: if isAdminUser() || ownsSessionNote(resource.data);
      allow create: if validSessionNoteCreate() || isAdminUser();
      allow update: if isAdminUser() || ownsSessionNote(resource.data);
      allow delete: if isAdminUser();
    }

    // ─── User Notifications ──────────────────────────────────────────────────
    match /users/{userId}/notifications/{notificationId} {
      allow read: if isSelf(userId) || isAdminUser();
      allow create: if isAdminUser() || isCounsellorUser();
      allow update: if isSelf(userId) || isAdminUser();
      allow delete: if isAdminUser();
    }

    // ─── inbox_messages (learning platform — teacher→student) ────────────────
    match /inbox_messages/{messageId} {
      allow read: if isAdminUser()
        || (isApprovedUser() && (
          resource.data.recipientId == request.auth.uid
          || resource.data.senderId == request.auth.uid
        ));
      allow create: if isAdminUser()
        || (isApprovedUser() && request.resource.data.senderId == request.auth.uid);
      allow update: if isAdminUser()
        || (isApprovedUser() && resource.data.recipientId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead', 'readAt']));
      allow delete: if isAdminUser();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}



